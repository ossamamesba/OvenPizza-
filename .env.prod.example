# Serveur de production : copier en .env (cp .env.prod.example .env) puis remplir.
# ⚠️ Ce fichier rempli contient des secrets : ne jamais le mettre sur GitHub (.env est ignoré par Git).

# Adresses (les enregistrements DNS A doivent pointer vers l'IP du serveur)
SITE_DOMAIN=ovenspizzaparty.ma
ADMIN_DOMAIN=admin.ovenspizzaparty.ma
API_DOMAIN=api.ovenspizzaparty.ma
# Email pour les certificats HTTPS (Let's Encrypt prévient avant expiration si besoin)
ACME_EMAIL=ovenspizzaparty@gmail.com

# Base de données — mots de passe longs et différents (ex. : openssl rand -hex 24)
MYSQL_DATABASE=ovens_pizza
MYSQL_USER=app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Secrets Symfony (ex. : openssl rand -hex 32) — ./deploy.sh les génère s'ils sont vides
APP_SECRET=
JWT_PASSPHRASE=

# Utilisateur du serveur (id -u / id -g)
UID=1000
GID=1000
