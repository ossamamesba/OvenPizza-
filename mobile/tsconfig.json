{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    /* Code partagé avec le site et le dashboard : ../shared */
    "paths": { "@shared/*": ["../shared/*"], "@/*": ["./src/*"] }
  },
  "include": ["**/*.ts", "**/*.tsx", "../shared/**/*.ts", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
